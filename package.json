    "@salesforce/ts-types": "^3.2.0",
    "@types/chai": "^4.3.17",
    "@types/chai-jest-snapshot": "^1.3.8",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "chai": "^4.5.0",
    "commitlint": "^18.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-salesforce-typescript": "^7.0.0",
    "eslint-plugin-header": "^3.0.0",
    "eslint-plugin-jsdoc": "^64.3.5",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^8.0.0",
    "lint-staged": "^15.5.2",
    "mocha": "^10.8.2",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-snap": "^5.0.1",
    "nyc": "^15.1.0",
    "prettier": "^3.9.6",
    "shx": "^0.4.0",
    "sinon": "^17.0.1",
    "source-map-support": "^0.5.16",
    "ts-node": "^10.9.2",
    "typescript": "^6",
    "typescript-eslint": "^8.69.0"
  },
  "resolutions": {
    "@jsforce/jsforce-node/node-fetch/whatwg-url": "^14.0.0"
  },
  "homepage": "https://github.com/forcedotcom/salesforcedx-apex",
  "keywords": [
    "apex",
    "force",
    "salesforce",
    "sfdx",
    "salesforcedx"
  ],
  "files": [
    "lib/src"
  ],
  "scripts": {
    "build": "shx rm -rf lib && tsc -b",
    "compile": "shx rm -rf lib && tsc -b",
    "commit-init": "commitizen init cz-conventional-changelog --save-dev --save-exact --force",
    "format": "prettier --config ./.prettierrc --write './{src,test,scripts}/**/*.{ts,js,json}'",
    "lint": "eslint ./src ./test",
    "test": "yarn build && nyc mocha ./lib/test/**/*.test.js",
    "package": "yarn pack",
    "prettier": "prettier ./**/*.{js,json,ts,md} --write",
    "format:check": "prettier ./**/*.{js,json,ts,md} --debug-check",
    "prepare": "husky install"
  },
  "lint-staged": {
    "./{src,test}/**/*.{ts,js}": [
      "eslint --fix"
    ]
  },
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
